library(shiny)
library(lubridate)
library(DT)
# Function for saving data to a CSV file
log_line <- function(newdata, filename = 'app_data.csv'){
(dt <- Sys.time() %>% round %>% as.character)
(newline <- c(dt, newdata) %>% paste(collapse=',') %>% paste0('\n'))
cat(newline, file=filename, append=TRUE)
print('Data stored!')
}
